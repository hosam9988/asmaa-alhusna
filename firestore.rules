rules_version = '2';

// Who may read and write the site's database. Paste this whole file into the Firebase console:
// Firestore Database → Rules → Publish (see docs/firebase-setup.md).
service cloud.firestore {
  match /databases/{database}/documents {

    // An admin is a signed-in account whose user id has a document in /admins. Only the project's
    // owner adds them, in the console: nothing on the site can.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // One added tab: the Arabic text (required), an English translation (may be empty), and when it
    // was saved. 40,000 characters per language, as in sections.service.ts.
    function isTab(tab) {
      return tab is map
        && tab.keys().hasAll(['ar'])
        && tab.keys().hasOnly(['ar', 'en', 'updatedAt'])
        && tab.ar is string && tab.ar.size() > 0 && tab.ar.size() <= 40000
        && (!('en' in tab) || (tab.en is string && tab.en.size() <= 40000))
        && (!('updatedAt' in tab) || tab.updatedAt is timestamp);
    }

    function isSections(data) {
      return data.keys().hasOnly(['uses', 'duas', 'story', 'life', 'faith'])
        && (!('uses' in data) || isTab(data.uses))
        && (!('duas' in data) || isTab(data.duas))
        && (!('story' in data) || isTab(data.story))
        && (!('life' in data) || isTab(data.life))
        && (!('faith' in data) || isTab(data.faith));
    }

    // The added tabs of a name's page: one document per chapter, e.g. sections/n30-al-fattah.
    // Everyone may read them; only admins may write them.
    match /sections/{chapter} {
      allow read: if true;
      allow create, update: if isAdmin()
        && chapter.matches('n[0-9]{2}-[a-z-]{1,40}')
        && isSections(request.resource.data);
      allow delete: if isAdmin();
    }

    // An account may check whether it is an admin, and nothing more.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }
  }
}
